{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "PRN232_Lab3",
    "Audience": "PRN232_Lab3_Users",

    "Secret": "YourSuperSecretKeyThatIsAtLeast32CharactersLongForLab3",

    "ValidateLifetime": true,
    "ClockSkewSeconds": 0
  },

  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**catchall}"
        }
      },
      "students": {
        "ClusterId": "students",
        "Match": {
          "Path": "/api/students/{**catchall}"
        }
      },
      "courses": {
        "ClusterId": "courses",
        "Match": {
          "Path": "/api/courses/{**catchall}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "identity1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "students": {
        "Destinations": {
          "students1": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "courses": {
        "Destinations": {
          "courses1": {
            "Address": "http://localhost:5003"
          }
        }
      }
    }
  }
}

